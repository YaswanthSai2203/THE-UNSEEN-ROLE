<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-check of the Unity runtime scripts against Unity reference assemblies (no Unity needed). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Unseen</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_Project/Scripts/**/*.cs" Exclude="../../../Assets/_Project/Scripts/Editor/**;../../../Assets/_Project/Scripts/URP/**" />
    <Reference Include="../ref/*.dll" Private="true" />
  </ItemGroup>
</Project>
